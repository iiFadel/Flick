<!--
  fork: Flick's Tangerine look (docs/TANGERINE-SPEC.md). Loaded after Soft.axaml, so its keys and setters win.
  Light values follow the recording of the real app; Windows has no backdrop blur behind part of a window, so the
  translucent glass of the site is replaced by the colours it ends up as over a light desktop. Dark values are our design.
-->
<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="using:Filee.App.Controls">

  <Styles.Resources>
    <ResourceDictionary>
      <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Light">
          <SolidColorBrush x:Key="WheelTrackBrush" Color="#F0D6DADB" />
          <RadialGradientBrush x:Key="PetalFill">
            <GradientStop Offset="0" Color="#F5F6F6" />
            <GradientStop Offset="0.68" Color="#E4E6E7" />
            <GradientStop Offset="1" Color="#E8EAEA" />
          </RadialGradientBrush>
          <SolidColorBrush x:Key="PetalStrokeBrush" Color="#385D6666" />
          <SolidColorBrush x:Key="PetalSelectedStrokeBrush" Color="#70C26534" />
          <Color x:Key="WheelShadowColor">#25263438</Color>
          <SolidColorBrush x:Key="WheelLabelBrush" Color="#000000" />
          <SolidColorBrush x:Key="WheelSubSliceBrush" Color="#ECEEEE" />
          <SolidColorBrush x:Key="CenterPillBrush" Color="#B8FFFFFF" />
          <SolidColorBrush x:Key="CenterPillBorderBrush" Color="#B3FFFFFF" />
          <BoxShadows x:Key="CenterPillShadow">0 2 6 0 #10000000</BoxShadows>
          <SolidColorBrush x:Key="WheelCardBrush" Color="#F2FFFFFF" />
          <SolidColorBrush x:Key="WheelCardBorderBrush" Color="#D9DFDA" />
          <SolidColorBrush x:Key="WheelCardTextBrush" Color="#828782" />
          <BoxShadows x:Key="WheelCardShadow">0 8 28 0 #2024323D</BoxShadows>
          <SolidColorBrush x:Key="ToastSurfaceBrush" Color="#F5F3F3F2" />
          <SolidColorBrush x:Key="ToastBorderBrush" Color="#D9DCDA" />
          <BoxShadows x:Key="ToastShadow">0 6 20 0 #2224323D</BoxShadows>
          <SolidColorBrush x:Key="ToastTitleBrush" Color="#5C605D" />
          <SolidColorBrush x:Key="ToastTextBrush" Color="#8A8F8B" />
          <SolidColorBrush x:Key="ProgressTrackBrush" Color="#DCDFDC" />
          <SolidColorBrush x:Key="ToastCloseBrush" Color="#E2E4E2" />
          <SolidColorBrush x:Key="ToastCloseGlyphBrush" Color="#7A7F7B" />
        </ResourceDictionary>
        <ResourceDictionary x:Key="Dark">
          <SolidColorBrush x:Key="WheelTrackBrush" Color="#F02A2D2F" />
          <RadialGradientBrush x:Key="PetalFill">
            <GradientStop Offset="0" Color="#43474A" />
            <GradientStop Offset="0.68" Color="#36393C" />
            <GradientStop Offset="1" Color="#3A3D40" />
          </RadialGradientBrush>
          <SolidColorBrush x:Key="PetalStrokeBrush" Color="#26FFFFFF" />
          <SolidColorBrush x:Key="PetalSelectedStrokeBrush" Color="#70FFB08A" />
          <Color x:Key="WheelShadowColor">#59000000</Color>
          <SolidColorBrush x:Key="WheelLabelBrush" Color="#F2F2F2" />
          <SolidColorBrush x:Key="WheelSubSliceBrush" Color="#3A3D40" />
          <SolidColorBrush x:Key="CenterPillBrush" Color="#D0303335" />
          <SolidColorBrush x:Key="CenterPillBorderBrush" Color="#33FFFFFF" />
          <BoxShadows x:Key="CenterPillShadow">0 2 6 0 #40000000</BoxShadows>
          <SolidColorBrush x:Key="WheelCardBrush" Color="#F2262624" />
          <SolidColorBrush x:Key="WheelCardBorderBrush" Color="#33FFFFFF" />
          <SolidColorBrush x:Key="WheelCardTextBrush" Color="#AEACA4" />
          <BoxShadows x:Key="WheelCardShadow">0 8 28 0 #59000000</BoxShadows>
          <SolidColorBrush x:Key="ToastSurfaceBrush" Color="#F22A2C2B" />
          <SolidColorBrush x:Key="ToastBorderBrush" Color="#33FFFFFF" />
          <BoxShadows x:Key="ToastShadow">0 8 24 0 #59000000</BoxShadows>
          <SolidColorBrush x:Key="ToastTitleBrush" Color="#EDEDEA" />
          <SolidColorBrush x:Key="ToastTextBrush" Color="#A3A6A2" />
          <SolidColorBrush x:Key="ProgressTrackBrush" Color="#3E413F" />
          <SolidColorBrush x:Key="ToastCloseBrush" Color="#3A3D3B" />
          <SolidColorBrush x:Key="ToastCloseGlyphBrush" Color="#B5B8B4" />
        </ResourceDictionary>
      </ResourceDictionary.ThemeDictionaries>

      <!-- Tangerine draws the wheel in SF Pro Rounded (Apple only); Nunito is the closest open rounded font. -->
      <FontFamily x:Key="WheelFontFamily">fonts:Filee#Nunito, Segoe UI Variable Text, Segoe UI, sans-serif</FontFamily>
    </ResourceDictionary>
  </Styles.Resources>

  <!-- The wheel. A group's ring and the editor's preview still use the slice keys: they get the same colours. -->
  <Style Selector="c|DonutMenu">
    <Setter Property="WheelTrackBrush" Value="{DynamicResource WheelTrackBrush}" />
    <Setter Property="PetalFill" Value="{DynamicResource PetalFill}" />
    <Setter Property="PetalStrokeBrush" Value="{DynamicResource PetalStrokeBrush}" />
    <Setter Property="PetalSelectedStrokeBrush" Value="{DynamicResource PetalSelectedStrokeBrush}" />
    <Setter Property="WheelShadowColor" Value="{DynamicResource WheelShadowColor}" />
    <Setter Property="WheelLabelBrush" Value="{DynamicResource WheelLabelBrush}" />
    <Setter Property="CenterPillBrush" Value="{DynamicResource CenterPillBrush}" />
    <Setter Property="CenterPillBorderBrush" Value="{DynamicResource CenterPillBorderBrush}" />
    <Setter Property="CenterPillShadow" Value="{DynamicResource CenterPillShadow}" />
    <Setter Property="WheelFontFamily" Value="{DynamicResource WheelFontFamily}" />
    <Setter Property="SliceBrush" Value="{DynamicResource WheelSubSliceBrush}" />
    <Setter Property="SliceBorderBrush" Value="{DynamicResource PetalStrokeBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource WheelLabelBrush}" />
  </Style>

  <!-- The drop toast (Views/DropToastWindow.axaml): sizes from the recording's proportions, our design in the details. -->
  <Style Selector="Border.drop-toast">
    <Setter Property="Width" Value="340" />
    <Setter Property="Padding" Value="14,12,16,14" />
    <Setter Property="CornerRadius" Value="14" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Background" Value="{DynamicResource ToastSurfaceBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource ToastBorderBrush}" />
    <Setter Property="BoxShadow" Value="{DynamicResource ToastShadow}" />
    <Setter Property="RenderTransformOrigin" Value="50%,50%" />
  </Style>
  <Style Selector="TextBlock.drop-toast-title">
    <Setter Property="Margin" Value="10,0,0,0" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="FontSize" Value="14" />
    <Setter Property="FontWeight" Value="Medium" />
    <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    <Setter Property="Foreground" Value="{DynamicResource ToastTitleBrush}" />
  </Style>
  <Style Selector="TextBlock.drop-toast-status">
    <Setter Property="FontSize" Value="12" />
    <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    <Setter Property="Foreground" Value="{DynamicResource ToastTextBrush}" />
  </Style>
  <Style Selector="ProgressBar.drop-toast-bar">
    <Setter Property="Height" Value="4" />
    <Setter Property="MinHeight" Value="4" />
    <Setter Property="CornerRadius" Value="2" />
    <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
    <Setter Property="Background" Value="{DynamicResource ProgressTrackBrush}" />
  </Style>
  <Style Selector="Button.drop-toast-close">
    <Setter Property="Width" Value="20" />
    <Setter Property="Height" Value="20" />
    <Setter Property="MinWidth" Value="0" />
    <Setter Property="MinHeight" Value="0" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="CornerRadius" Value="10" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="Background" Value="{DynamicResource ToastCloseBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource ToastCloseGlyphBrush}" />
  </Style>
  <Style Selector="Button.drop-toast-close PathIcon">
    <Setter Property="Width" Value="8" />
    <Setter Property="Height" Value="8" />
  </Style>
</Styles>
