<!-- fork: the small popover at the drop point where a Tools wheel operation asks for its one value (Speed 2×, Mono, …);
     looks like the drop toast that follows it (styles in Styles/Flick.axaml). -->
<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Filee.App.ViewModels"
        x:Class="Filee.App.Views.ValuePopoverWindow"
        x:DataType="vm:ValuePopoverViewModel"
        Title="{DynamicResource app.name}"
        SizeToContent="WidthAndHeight"
        WindowDecorations="None"
        Background="Transparent"
        TransparencyLevelHint="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ShowActivated="False"
        CanResize="False">
  <!-- Room around the card for its shadow. -->
  <Border x:Name="Card" Classes="drop-toast value-popover" Margin="20">
    <StackPanel Spacing="10">
      <TextBlock Classes="drop-toast-title value-popover-title" Text="{Binding Title}" />
      <ItemsControl ItemsSource="{Binding Choices}">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate>
            <WrapPanel Orientation="Horizontal" />
          </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="vm:ValueChoice">
            <Button Classes="value-choice" Classes.selected="{Binding IsSelected}" Content="{Binding Label}"
                    Command="{Binding Owner.PickCommand}" CommandParameter="{Binding Index}" />
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </StackPanel>
  </Border>
</Window>
