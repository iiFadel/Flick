<!-- fork: the Trim editor's body (TrimEditorViewModel): the frame under the handle (video) or a big waveform (audio),
     the timeline, then the times, "Remove silence" and Reset. ← → move the selected handle a frame (Shift: a second). -->
<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ed="using:Filee.App.Editors"
             x:Class="Filee.App.Editors.TrimEditorView"
             x:DataType="ed:TrimEditorViewModel">
  <DockPanel Margin="18,0">
    <Border DockPanel.Dock="Bottom" Padding="0,10,0,0">
      <DockPanel>
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
          <Button Classes="editor-choice" Content="{DynamicResource editor.trim.remove_silence}" Command="{Binding RemoveSilenceCommand}"
                  IsEnabled="{Binding !IsFindingSilence}" />
          <Button Classes="editor-choice" Content="{DynamicResource editor.reset}" Command="{Binding ResetCommand}" />
        </StackPanel>
        <StackPanel Orientation="Horizontal" Spacing="18" VerticalAlignment="Center">
          <StackPanel Orientation="Horizontal" Spacing="6">
            <TextBlock Classes="editor-label" Text="{DynamicResource editor.trim.start}" />
            <TextBlock Text="{Binding StartText}" FontFamily="Consolas, monospace" FontSize="12" Foreground="{DynamicResource ToastTitleBrush}" VerticalAlignment="Center" />
          </StackPanel>
          <StackPanel Orientation="Horizontal" Spacing="6">
            <TextBlock Classes="editor-label" Text="{DynamicResource editor.trim.end}" />
            <TextBlock Text="{Binding EndText}" FontFamily="Consolas, monospace" FontSize="12" Foreground="{DynamicResource ToastTitleBrush}" VerticalAlignment="Center" />
          </StackPanel>
          <StackPanel Orientation="Horizontal" Spacing="6">
            <TextBlock Classes="editor-label" Text="{DynamicResource editor.trim.length}" />
            <TextBlock Text="{Binding LengthText}" FontFamily="Consolas, monospace" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center" />
          </StackPanel>
        </StackPanel>
      </DockPanel>
    </Border>

    <ed:TrimTimeline x:Name="Timeline" DockPanel.Dock="Bottom" Height="64" Margin="0,12,0,0"
                     Duration="{Binding Duration}" Range="{Binding Range}" Frames="{Binding Frames}" Peaks="{Binding Peaks}"
                     Selected="{Binding Selected}" Accent="{DynamicResource AccentBrush}" Track="{DynamicResource ProgressTrackBrush}" />

    <Border CornerRadius="10" ClipToBounds="True" Background="#14000000">
      <Grid>
        <Image Source="{Binding Frame}" Stretch="Uniform" IsVisible="{Binding IsVideo}" />
        <ed:TrimTimeline IsVisible="{Binding !IsVideo}" IsHitTestVisible="False" Margin="12,24"
                         Duration="{Binding Duration}" Range="{Binding Range}" Peaks="{Binding Peaks}"
                         Accent="{DynamicResource AccentBrush}" Track="Transparent" />
      </Grid>
    </Border>
  </DockPanel>
</UserControl>
